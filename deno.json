{
  "tasks": {
    "build": "deno run -A npm:astro build",
    "dev": "deno run -A npm:astro dev",
    "check": "deno task format:check && deno task lint:check && deno task astro:check",
    "fix": "deno task lint:fix && deno task format:write",
    "astro:check": "deno run -A npm:astro check",
    "lint:check": "deno lint",
    "lint:fix": "deno lint --fix",
    "format:write": "deno fmt",
    "format:check": "deno fmt --check",
    "prepare": "deno run -A npm:is-ci || deno run -A npm:lefthook install",
    "preview": "deno run -A npm:astro preview",
    "update-dependencies": "deno run -A npm:@astrojs/upgrade"
  },
  "fmt": {
    "exclude": ["dist", "node_modules", ".astro", "deno.lock"],
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": ["dist", "node_modules", ".astro"],
    "rules": {
      "exclude": ["no-unused-vars", "triple-slash-reference"]
    }
  },
  "imports": {
    "@astrojs/check": "npm:@astrojs/check@0.9.10",
    "@astrojs/mdx": "npm:@astrojs/mdx@7.0.5",
    "@astrojs/rss": "npm:@astrojs/rss@4.0.19",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@0.5.20",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "@types/markdown-it": "npm:@types/markdown-it@14.1.2",
    "astro": "npm:astro@7.2.0",
    "is-ci": "npm:is-ci@4.1.0",
    "lefthook": "npm:lefthook@2.1.10",
    "markdown-it": "npm:markdown-it@15.0.0",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "typescript": "npm:typescript@6.0.3"
  },
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:esbuild@0.27.7",
    "npm:fsevents@2.3.3",
    "npm:lefthook@2.0.7",
    "npm:lefthook@2.1.8",
    "npm:sharp@0.34.5"
  ]
}
