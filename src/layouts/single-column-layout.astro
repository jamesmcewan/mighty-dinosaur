---
import FooterBlock from "@/components/block/footer-block.astro"
import GridBlock from "@/components/block/grid-block.astro"
import PageHeaderBlock from "@/components/block/page-header-block.astro"
import WrapperBlock from "@/components/block/wrapper-block.astro"
import Body from "@/components/structure/body.astro"

interface Props {
  title: string
  description: string
  url: string
}

const { title, description, url }: Props = Astro.props
---

<Body {title} {description} {url}>
  <WrapperBlock>
    <GridBlock>
      <PageHeaderBlock />
      <slot />
      <FooterBlock />
    </GridBlock>
  </WrapperBlock>
</Body>
